@model WEB_TinhNguyen.Models.CauHinhGayQuy
@{
    ViewData["Title"] = "Gây quỹ & Đồng hành";
    var fontHeading = string.IsNullOrEmpty(Model?.FontTieuDe) ? "Be Vietnam Pro" : Model.FontTieuDe;
    var fontBody = string.IsNullOrEmpty(Model?.FontNoiDung) ? "Be Vietnam Pro" : Model.FontNoiDung;
}

<!-- Tự động nhúng Google Fonts theo cấu hình của Admin -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=@(fontHeading.Replace(" ", "+")):wght@400;600;700;800&family=@(fontBody.Replace(" ", "+")):wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    .gayquy-wrapper {
        font-family: '@Html.Raw(fontBody)', sans-serif;
    }
    .gayquy-heading {
        font-family: '@Html.Raw(fontHeading)', sans-serif;
    }
</style>

<div class="w-full gayquy-wrapper">
    <!-- SECTION 1: HERO -->
    <section class="relative overflow-hidden pt-28 pb-16 sm:pt-36 lg:pt-40 lg:pb-24 min-h-[calc(100vh-5rem)] xl:min-h-0 flex items-center"
             style="background: linear-gradient(to bottom, @(Model?.Hero_MauNenStart ?? "#e0f2fe"), @(Model?.Hero_MauNenMid ?? "#c9ecf2"), @(Model?.Hero_MauNenEnd ?? "#fefce8"));">
        <!-- SVG Trang trí (Giữ nguyên 100%) -->
        <svg viewBox="0 0 320 220" class="pointer-events-none absolute -left-6 -top-6 z-10 h-56 w-72 opacity-90 md:h-72 md:w-96" aria-hidden="true">
            <g fill="none" stroke="#2e7d32" stroke-width="3" stroke-linecap="round">
                <path d="M10 10 C 80 40, 150 30, 240 80" opacity="0.6"></path>
                <path d="M10 10 C 60 70, 120 90, 200 150" opacity="0.5"></path>
            </g>
            <ellipse cx="40" cy="22" rx="20" ry="9" fill="#5cb85c" transform="rotate(25 40 22)" opacity="0.95"></ellipse>
            <ellipse cx="78" cy="40" rx="22" ry="10" fill="#7cc34a" transform="rotate(35 78 40)" opacity="0.9"></ellipse>
            <ellipse cx="120" cy="34" rx="18" ry="8" fill="#4caf50" transform="rotate(20 120 34)" opacity="0.95"></ellipse>
            <ellipse cx="165" cy="58" rx="24" ry="11" fill="#5cb85c" transform="rotate(40 165 58)" opacity="0.9"></ellipse>
            <ellipse cx="210" cy="82" rx="20" ry="9" fill="#7cc34a" transform="rotate(30 210 82)" opacity="0.92"></ellipse>
            <ellipse cx="60" cy="78" rx="18" ry="8" fill="#4caf50" transform="rotate(55 60 78)" opacity="0.85"></ellipse>
            <ellipse cx="110" cy="100" rx="22" ry="10" fill="#5cb85c" transform="rotate(60 110 100)" opacity="0.9"></ellipse>
            <ellipse cx="160" cy="128" rx="20" ry="9" fill="#7cc34a" transform="rotate(65 160 128)" opacity="0.88"></ellipse>
            <ellipse cx="200" cy="150" rx="17" ry="8" fill="#4caf50" transform="rotate(70 200 150)" opacity="0.85"></ellipse>
        </svg>
        <svg width="34" height="34" viewBox="0 0 40 40" class="pointer-events-none absolute bottom-8 right-6 z-10 h-16 w-16 opacity-80 md:h-24 md:w-24" aria-hidden="true">
            <ellipse cx="20" cy="8" rx="4.2" ry="9" fill="#ffffff" transform="rotate(0 20 20)"></ellipse>
            <ellipse cx="20" cy="8" rx="4.2" ry="9" fill="#ffffff" transform="rotate(45 20 20)"></ellipse>
            <ellipse cx="20" cy="8" rx="4.2" ry="9" fill="#ffffff" transform="rotate(90 20 20)"></ellipse>
            <ellipse cx="20" cy="8" rx="4.2" ry="9" fill="#ffffff" transform="rotate(135 20 20)"></ellipse>
            <ellipse cx="20" cy="8" rx="4.2" ry="9" fill="#ffffff" transform="rotate(180 20 20)"></ellipse>
            <ellipse cx="20" cy="8" rx="4.2" ry="9" fill="#ffffff" transform="rotate(225 20 20)"></ellipse>
            <ellipse cx="20" cy="8" rx="4.2" ry="9" fill="#ffffff" transform="rotate(270 20 20)"></ellipse>
            <ellipse cx="20" cy="8" rx="4.2" ry="9" fill="#ffffff" transform="rotate(315 20 20)"></ellipse>
            <circle cx="20" cy="20" r="5.5" fill="#f5a623"></circle>
        </svg>

        <div class="relative z-10 mx-auto max-w-7xl px-6 w-full">
            <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
                <div class="flex flex-col items-start text-left">
                    <div>
                        <div class="inline-flex items-center gap-2 rounded-full px-4 py-2 backdrop-blur-md"
                             style="background-color: @(Model?.Hero_MauNenNhan ?? "#dcfce7");">
                            <span class="h-2 w-2 rounded-full" style="background-color: @(Model?.Hero_MauChuNhan ?? "#2e7d32");"></span>
                            <span class="text-xs font-bold uppercase tracking-wider" style="color: @(Model?.Hero_MauChuNhan ?? "#2e7d32");">
                                @(Model?.Hero_Nhan ?? "KHÔNG GIAN YÊU THƯƠNG")
                            </span>
                        </div>
                    </div>
                    <div class="mt-6">
                        <h1 class="gayquy-heading font-extrabold tracking-tight leading-tight"
                            style="color: @(Model?.Hero_MauTieuDe ?? "#1b5e20"); font-size: @(Model?.Hero_CoChuTieuDe ?? "48px");">
                            @(Model?.Hero_TieuDe ?? "HÌNH THỨC TRAO GỬI YÊU THƯƠNG")
                        </h1>
                    </div>
                    <div class="mt-6">
                        <p class="max-w-xl text-lg leading-relaxed" style="color: @(Model?.Hero_MauMoTa ?? "#374151");">
                            @(Model?.Hero_MoTa ?? "Có nhiều cách để bạn kề vai, sát cánh cùng dự án. Mọi sự ủng hộ thông qua các \"Gói yêu thương\", hiện kim, nhu yếu phẩm hay chỉ một lời chúc tốt đẹp đều là những mảnh ghép làm nên một mùa Trung thu diệu kỳ!")
                        </p>
                    </div>
                    <div class="mt-8 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
                        <a href="@(Model?.Hero_LinkNut ?? "#ways-to-contribute")"
                           class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full px-8 py-4 font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:shadow-lg text-base"
                           style="background: linear-gradient(to right, @(Model?.Hero_MauNutStart ?? "#2e7d32"), @(Model?.Hero_MauNutEnd ?? "#7cc34a"));">
                            @(Model?.Hero_TextNut ?? "Đóng góp ngay")
                        </a>
                    </div>
                </div>
                <div class="relative w-full aspect-[4/3] rounded-[2rem] overflow-hidden shadow-2xl border-4 border-white transition duration-500 hover:scale-[1.02]">
                    <img alt="@Model?.Hero_TieuDe" src="@(string.IsNullOrEmpty(Model?.Hero_LinkAnh) ? "/gallery/2025/bro02087.jpg" : Model.Hero_LinkAnh)" class="object-cover w-full h-full" />
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION 2: CÁCH THỨC ĐÓNG GÓP -->
    <section id="ways-to-contribute" class="py-20 sm:py-28 relative z-20 max-w-7xl mx-auto px-6 w-full">
        <div class="mx-auto max-w-2xl text-center mb-12 sm:mb-16">
            <span class="mb-4 sm:mb-6 inline-block rounded-full bg-leaf/15 px-4 py-1.5 text-xs font-bold uppercase tracking-widest"
                  style="color: @(Model?.MauChuDao ?? "#2e7d32");">
                @(Model?.DongGop_Nhan ?? "Kênh ủng hộ")
            </span>
            <h2 class="gayquy-heading text-3xl font-extrabold leading-tight sm:text-4xl md:text-5xl"
                style="color: @(Model?.DongGop_MauTieuDe ?? "#1b5e20");">
                @(Model?.DongGop_TieuDe ?? "Cách thức đóng góp")
            </h2>
            <p class="mt-4 text-base sm:text-lg" style="color: @(Model?.DongGop_MauMoTa ?? "#374151");">
                @(Model?.DongGop_MoTa ?? "Cùng chung tay lan tỏa yêu thương bằng phương thức phù hợp nhất với bạn.")
            </p>
        </div>

        <div class="flex flex-wrap justify-center gap-6 mx-auto">
            @if (Model?.KenhDongGops != null && Model.KenhDongGops.Any())
            {
                foreach (var kenh in Model.KenhDongGops.OrderBy(k => k.ThuTu))
                {
                    <article class="flex flex-col border border-leaf/10 rounded-2xl p-6 gap-5 shadow-sm hover:shadow-md transition-shadow w-full max-w-[360px]"
                             style="background-color: @(kenh.MauNenCard ?? "#ffffff");">
                        <div class="w-12 h-12 rounded-full flex items-center justify-center"
                             style="background-color: @(kenh.MauNenIcon ?? "#dcfce7"); color: @(kenh.MauIcon ?? "#2e7d32");">
                            @if (kenh.LoaiIcon == "gift")
                            {
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            }
                            else if (kenh.LoaiIcon == "heart")
                            {
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                            }
                            else
                            {
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                            }
                        </div>

                        <div class="flex flex-col gap-2 flex-1">
                            <h3 class="gayquy-heading text-lg font-bold" style="color: @(kenh.MauTieuDe ?? "#1b5e20");">@kenh.TenKenh</h3>
                            <p class="text-sm leading-relaxed" style="color: @(kenh.MauMoTa ?? "#374151");">@kenh.MoTa</p>
                        </div>

                        @if (kenh.LoaiHanhDong == "qr")
                        {
                            <button type="button"
                                    onclick="openQrModal('@Html.Raw(kenh.TenKenh)', '@Html.Raw(kenh.LinkAnhQR)', '@Html.Raw(kenh.TenNganHang)', '@Html.Raw(kenh.SoTaiKhoan)', '@Html.Raw(kenh.TenChuTaiKhoan)', '@Html.Raw(kenh.NoiDungChuyenKhoan)')"
                                    class="inline-flex items-center justify-center gap-2 text-white font-semibold text-sm px-4 py-2.5 rounded-xl hover:brightness-110 shadow-soft transition-all w-full mt-auto cursor-pointer"
                                    style="background: linear-gradient(to right, @(Model?.Hero_MauNutStart ?? "#2e7d32"), @(Model?.Hero_MauNutEnd ?? "#7cc34a"));">
                                @kenh.TextNut
                            </button>
                        }
                        else
                        {
                            <a href="@kenh.LinkNgoai" target="_blank" rel="noopener noreferrer"
                               class="inline-flex items-center justify-center gap-2 font-semibold text-sm px-4 py-2.5 rounded-xl transition-all w-full mt-auto cursor-pointer text-white hover:brightness-110 shadow-soft"
                               style="background: linear-gradient(to right, @(Model?.Hero_MauNutStart ?? "#2e7d32"), @(Model?.Hero_MauNutEnd ?? "#7cc34a"));">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                                @kenh.TextNut
                            </a>
                        }
                    </article>
                }
            }
        </div>

        @if (!string.IsNullOrEmpty(Model?.DongGop_GhiChuChanTrang))
        {
            <div class="mt-10 text-center">
                <p class="text-sm text-forest/60">@Model.DongGop_GhiChuChanTrang</p>
            </div>
        }
    </section>

    <!-- SECTION 3: BÁO CÁO THU CHI -->
    <section id="bao-cao-chi" class="py-16 sm:py-24" style="background-color: @(Model?.BaoCao_MauNen ?? "#eef8ea");">
        <div class="mx-auto max-w-2xl px-5 text-center sm:px-6">
            <span class="mb-3 inline-block rounded-full bg-leaf/15 px-4 py-1.5 text-xs font-bold uppercase tracking-widest"
                  style="color: @(Model?.MauChuDao ?? "#2e7d32");">
                @(Model?.BaoCao_Nhan ?? "Minh bạch")
            </span>
            <h2 class="gayquy-heading whitespace-pre-line text-3xl font-extrabold leading-tight sm:text-4xl md:text-5xl"
                style="color: @(Model?.BaoCao_MauTieuDe ?? "#1b5e20");">
                @(Model?.BaoCao_TieuDe ?? "Báo cáo thu – chi")
            </h2>
            <p class="mt-4 text-base sm:text-lg" style="color: @(Model?.BaoCao_MauMoTa ?? "#374151");">
                @(Model?.BaoCao_MoTa ?? "Toàn bộ khoản thu – chi được cập nhật công khai trên các kênh thông tin của Dự án.")
            </p>
            @if (!string.IsNullOrEmpty(Model?.BaoCao_LinkNut))
            {
                <a href="@Model.BaoCao_LinkNut" target="_blank" rel="noopener noreferrer"
                   class="mt-7 inline-flex items-center gap-2 rounded-full px-7 py-3 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:brightness-110"
                   style="background: linear-gradient(to right, @(Model?.Hero_MauNutStart ?? "#2e7d32"), @(Model?.Hero_MauNutEnd ?? "#7cc34a"));">
                    @(Model?.BaoCao_TextNut ?? "Xem báo cáo chi tiết")
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"></path></svg>
                </a>
            }
        </div>
    </section>

    <!-- SECTION 4: ĐƠN VỊ TÀI TRỢ -->
    <section class="relative overflow-x-hidden py-16 sm:py-24">
        <span id="sponsors" aria-hidden="true" class="block"></span>
        <div class="mx-auto max-w-7xl px-5 sm:px-6">
            <div class="mx-auto max-w-3xl text-center">
                <span class="mb-4 sm:mb-6 inline-block rounded-full bg-sun/15 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-sunset">
                    @(Model?.TaiTro_Nhan ?? "Những mảnh ghép tạo nên Trăng sáng Langbiang")
                </span>
                <h2 class="gayquy-heading whitespace-pre-line text-3xl font-extrabold leading-tight sm:text-4xl md:text-5xl"
                    style="color: @(Model?.TaiTro_MauTieuDe ?? "#1b5e20");">
                    @(Model?.TaiTro_TieuDe ?? "ĐƠN VỊ TỔ CHỨC - TÀI TRỢ")
                    <span class="inline-block text-gradient-sun">@(Model?.TaiTro_TieuDeNoiBat ?? "NĂM 2026")</span>
                </h2>
                <p class="mt-4 text-base text-forest/75 sm:text-lg">
                    @(Model?.TaiTro_MoTa ?? "Mỗi đơn vị là một mảnh ghép quan trọng, cùng nhau thắp sáng và làm nên một mùa trăng thật trọn vẹn!")
                </p>
            </div>

            <div class="mt-12 space-y-10 sm:mt-14 sm:space-y-12">
                @if (Model?.NhaTaiTroGayQuys != null && Model.NhaTaiTroGayQuys.Any())
                {
                    var groupedSponsors = Model.NhaTaiTroGayQuys.OrderBy(n => n.ThuTu).GroupBy(n => n.NhomTaiTro);
                    foreach (var group in groupedSponsors)
                    {
                        <div>
                            <div class="mb-5 flex items-center gap-4">
                                <h3 class="text-sm font-bold uppercase tracking-widest" style="color: @(Model?.MauChuDao ?? "#2e7d32");">@group.Key</h3>
                                <div class="h-px flex-1 bg-gradient-to-r from-leaf/40 to-transparent"></div>
                            </div>
                            <div class="flex flex-wrap justify-center gap-5 sm:gap-6">
                                @foreach (var sp in group)
                                {
                                    <button type="button"
                                            title="@sp.TenDonVi"
                                            onclick="openSponsorModal('@Html.Raw(sp.TenDonVi)', '@Html.Raw(sp.LinkLogo)', '@Html.Raw(sp.GioiThieu?.Replace("'", "\\'").Replace("\r\n", " "))', '@Html.Raw(sp.LinkWebsite)')"
                                            class="group relative flex h-28 w-44 items-center justify-center rounded-2xl bg-white p-5 ring-1 ring-leaf/10 transition hover:-translate-y-1.5 sm:h-32 sm:w-56 sm:p-6 shadow-sm">
                                        <img alt="@sp.TenDonVi" src="@sp.LinkLogo" class="object-contain p-3 transition duration-300 group-hover:scale-105 w-full h-full" />
                                        <span class="pointer-events-none absolute left-1/2 top-full z-10 mt-2 -translate-x-1/2 translate-y-1 whitespace-nowrap rounded-full bg-forest px-3 py-1 text-xs font-semibold text-cream opacity-0 transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100">
                                            @sp.TenDonVi
                                        </span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
</div>

<!-- POPUP 1: MODAL HIỂN THỊ MÃ QR CHUYỂN KHOẢN -->
<div id="qrModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl relative animate-fadeIn text-center">
        <button type="button" onclick="closeQrModal()" class="absolute top-4 right-4 h-9 w-9 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center font-bold text-gray-600">✕</button>
        <h3 id="qrModalTitle" class="text-xl font-extrabold text-emerald-800 mb-4">Thông tin Quyên góp</h3>
        <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200 inline-block mb-4">
            <img id="qrModalImg" src="" alt="QR Code" class="w-56 h-56 object-contain mx-auto rounded-lg" />
        </div>
        <div class="text-left space-y-2 bg-emerald-50/70 p-4 rounded-2xl border border-emerald-100 text-sm">
            <p><span class="text-gray-500">Ngân hàng:</span> <strong id="qrModalBank" class="text-gray-900"></strong></p>
            <p><span class="text-gray-500">Số tài khoản:</span> <strong id="qrModalAccNum" class="text-emerald-700 text-base select-all"></strong></p>
            <p><span class="text-gray-500">Chủ tài khoản:</span> <strong id="qrModalAccName" class="text-gray-900"></strong></p>
            <p><span class="text-gray-500">Nội dung CK:</span> <strong id="qrModalNote" class="text-amber-700 select-all"></strong></p>
        </div>
    </div>
</div>

<!-- POPUP 2: MODAL GIỚI THIỆU NHÀ TÀI TRỢ -->
<div id="sponsorModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl relative text-center">
        <button type="button" onclick="closeSponsorModal()" class="absolute top-4 right-4 h-9 w-9 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center font-bold text-gray-600">✕</button>
        <img id="spModalLogo" src="" class="h-24 object-contain mx-auto mb-4" />
        <h3 id="spModalName" class="text-xl font-extrabold text-gray-900 mb-3"></h3>
        <p id="spModalIntro" class="text-sm text-gray-600 leading-relaxed mb-6"></p>
        <a id="spModalLink" href="#" target="_blank" class="inline-flex items-center gap-2 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-6 py-2.5 text-sm transition">
            Tìm hiểu thêm ↗
        </a>
    </div>
</div>

<script>
    function openQrModal(title, qrUrl, bank, accNum, accName, note) {
        document.getElementById('qrModalTitle').innerText = title;
        document.getElementById('qrModalImg').src = qrUrl || '/logo-mark.png';
        document.getElementById('qrModalBank').innerText = bank;
        document.getElementById('qrModalAccNum').innerText = accNum;
        document.getElementById('qrModalAccName').innerText = accName;
        document.getElementById('qrModalNote').innerText = note;
        const modal = document.getElementById('qrModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }
    function closeQrModal() {
        const modal = document.getElementById('qrModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }

    function openSponsorModal(name, logo, intro, url) {
        if (!intro && !url) return;
        document.getElementById('spModalName').innerText = name;
        document.getElementById('spModalLogo').src = logo;
        document.getElementById('spModalIntro').innerText = intro || "Cảm ơn đơn vị đã đồng hành cùng chiến dịch!";
        const linkBtn = document.getElementById('spModalLink');
        if (url) {
            linkBtn.href = url;
            linkBtn.classList.remove('hidden');
        } else {
            linkBtn.classList.add('hidden');
        }
        const modal = document.getElementById('sponsorModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }
    function closeSponsorModal() {
        const modal = document.getElementById('sponsorModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }
</script>