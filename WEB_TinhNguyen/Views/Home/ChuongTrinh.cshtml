@model WEB_TinhNguyen.Models.CauHinhChuongTrinh

@{
    ViewData["Title"] = "Chương trình " + ViewBag.Nam;
    var conf = Model ?? new CauHinhChuongTrinh();
}

<style>
    .dynamic-font {
        font-family: '@(conf.FontTieuDe ?? "Be Vietnam Pro")', sans-serif !important;
    }

    .dynamic-bg {
        background: linear-gradient(to bottom, #e0f7fa, @(conf.MauNenHienTai ?? "#c9ecf2"), #fffdd0) !important;
    }
</style>

<main>
    <!-- HERO SECTION ĐỘNG -->
    <section class="relative overflow-hidden pt-28 pb-16 sm:pt-36 lg:pt-40 lg:pb-24 min-h-[calc(100vh-5rem)] xl:min-h-0 flex items-center dynamic-bg">
        <div class="relative z-10 mx-auto max-w-7xl px-6">
            <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
                <div class="flex flex-col items-start text-left">
                    <div>
                        <div class="inline-flex items-center gap-2 rounded-full px-4 py-2 backdrop-blur-md shadow-sm" style="background-color: @(conf.MauChuDao ?? "#4caf50")20;">
                            <span class="h-2 w-2 rounded-full" style="background-color: @(conf.MauChuDao ?? "#2e7d32");"></span>
                            <span class="text-xs font-bold uppercase tracking-wider" style="color: @(conf.MauChu ?? "#1b5e20");">Nội dung chương trình @ViewBag.Nam</span>
                        </div>
                    </div>
                    <div class="mt-6">
                        <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl dynamic-font" style="color: @(conf.MauChu ?? "#1b5e20");">
                            @conf.TieuDeChinh <br class="hidden md:block">
                            <span class="text-gradient-green" style="background: linear-gradient(to right, @(conf.MauChuDao ?? "#4caf50"), @(conf.MauChu ?? "#1b5e20")); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                                @conf.TieuDeNhanManh
                            </span>
                        </h1>
                    </div>
                    <div class="mt-6">
                        <p class="max-w-xl text-lg leading-relaxed opacity-80" style="color: @(conf.MauChu ?? "#1b5e20");">
                            @conf.DoanVanMoTa
                        </p>
                    </div>
                </div>

                <!-- ẢNH HERO -->
                <div class="relative block h-[300px] sm:h-[400px] lg:h-[480px] w-full mt-6 lg:mt-0">
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[80%] w-[80%] rounded-full blur-3xl -z-10" style="background-color: @(conf.MauChuDao ?? "#4caf50")20;"></div>

                    <div class="absolute top-0 right-0 h-[68%] w-[62%] rounded-[2rem] overflow-hidden shadow-2xl z-20 hover:z-30 border-4 border-white transform translate-x-3 -translate-y-2 transition duration-500 hover:scale-105">
                        <img src="@(conf.LinkAnhHero1 ?? "/gallery/team.jpg")" class="object-cover h-full w-full" />
                    </div>

                    <div class="absolute bottom-0 left-0 h-[62%] w-[68%] rounded-[2rem] overflow-hidden shadow-2xl z-10 hover:z-30 border-4 border-white transition duration-500 hover:scale-105">
                        <img src="@(conf.LinkAnhHero2 ?? "/gallery/team.jpg")" class="object-cover h-full w-full" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CÁC CHẶNG CHƯƠNG TRÌNH -->
    <section id="programs" class="py-20 sm:py-28 relative border-y border-gray-200" style="background: linear-gradient(to bottom, #ffffff, @(conf.MauNenHienTai ?? "#eef8ea"));">
        <div class="mx-auto max-w-7xl px-6">
            <div class="text-center mb-16 sm:mb-24">
                <span class="mb-4 sm:mb-6 inline-block rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-widest" style="background-color: @(conf.MauChuDao ?? "#4caf50")15; color: @(conf.MauChuDao ?? "#2e7d32");">
                    Trọng tâm @ViewBag.Nam
                </span>
                <h2 class="text-3xl font-extrabold sm:text-4xl lg:text-5xl" style="color: @(conf.MauChu ?? "#1b5e20");">
                    NỘI DUNG CHƯƠNG TRÌNH
                </h2>
                <div class="w-16 h-1 mx-auto rounded-full mt-6" style="background-color: @(conf.MauChuDao ?? "#2e7d32");"></div>
            </div>

            <div class="space-y-24 lg:space-y-32">
                @if (conf.ChangChuongTrinhs != null && conf.ChangChuongTrinhs.Any())
                {
                    var sortedChangs = conf.ChangChuongTrinhs.OrderBy(x => x.ThuTu).ToList();
                    for (int i = 0; i < sortedChangs.Count; i++)
                    {
                        var chang = sortedChangs[i];
                        bool isReverse = i % 2 != 0; // Đảo layout Ảnh trái / phải so le

                        <div class="flex flex-col lg:flex-row gap-12 items-center">
                            <!-- Cột Nội Dung -->
                            <div class="w-full lg:w-1/2 @(isReverse ? "order-2 lg:order-2 lg:pl-8" : "order-2 lg:order-1")">
                                <div class="inline-flex items-center px-4 py-1.5 rounded-full font-semibold text-xs mb-4 shadow-sm" style="background-color: @(conf.MauChuDao ?? "#4caf50")15; color: @(conf.MauChuDao ?? "#2e7d32");">
                                    @chang.NhanThoiGian
                                </div>
                                <h3 class="text-2xl sm:text-3xl lg:text-4xl leading-tight font-extrabold mb-4" style="color: @(conf.MauChu ?? "#1b5e20");">@chang.TieuDeChang</h3>
                                <p class="text-base sm:text-lg leading-relaxed mb-6" style="color: @(conf.MauChu ?? "#1b5e20")cc;">@chang.MoTaChang</p>

                                <div class="flex items-start gap-2 text-sm mb-6 bg-white p-4 rounded-xl border shadow-sm" style="color: @(conf.MauChu ?? "#1b5e20"); border-color: @(conf.MauChuDao ?? "#4caf50")30;">
                                    <svg class="h-5 w-5 shrink-0 mt-0.5" style="color: @(conf.MauChuDao ?? "#2e7d32");" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                    <span class="font-medium">@chang.DiaDiem</span>
                                </div>

                                <!-- Box Lộ trình (Timeline) Sinh Tự Động -->
                                <div class="bg-white/80 p-6 rounded-2xl border shadow-md backdrop-blur-sm" style="border-color: @(conf.MauChuDao ?? "#4caf50")30;">
                                    <h4 class="font-bold text-lg mb-4" style="color: @(conf.MauChu ?? "#1b5e20");">Lộ trình triển khai</h4>
                                    <div class="flex flex-col space-y-4">
                                        @if (chang.ChiTietLoTrinhs != null && chang.ChiTietLoTrinhs.Any())
                                        {
                                            var loTrinhs = chang.ChiTietLoTrinhs.OrderBy(l => l.ThuTu).ToList();
                                            for (int j = 0; j < loTrinhs.Count; j++)
                                            {
                                                bool isLast = (j == loTrinhs.Count - 1);
                                                <div class="flex gap-4 items-start group">
                                                    <!-- Cột dấu chấm và đường kẻ dọc -->
                                                    <div class="flex flex-col items-center">
                                                        <div class="w-3 h-3 rounded-full mt-1" style="background-color: @(conf.MauChuDao ?? "#2e7d32"); box-shadow: 0 0 0 4px @(conf.MauChuDao ?? "#4caf50")33;"></div>
                                                        @if (!isLast)
                                                        {
                                                            <div class="w-0.5 h-8 my-1" style="background-color: @(conf.MauChuDao ?? "#4caf50")40;"></div>
                                                        }
                                                    </div>
                                                    <!-- Cột Nội dung -->
                                                    <div>
                                                        <h5 class="font-bold text-sm" style="color: @(conf.MauChuDao ?? "#2e7d32");">@loTrinhs[j].ThoiGian</h5>
                                                        <p class="text-xs sm:text-sm mt-0.5" style="color: @(conf.MauChu ?? "#1b5e20")cc;">@loTrinhs[j].NoiDungHoatDong</p>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Cột Ảnh -->
                            <div class="w-full lg:w-1/2 @(isReverse ? "order-1 lg:order-1" : "order-1 lg:order-2")">
                                <div class="rounded-[2.5rem] overflow-hidden shadow-2xl relative aspect-[4/3] border-4 border-white transition duration-500 hover:scale-[1.02]">
                                    <img src="@(chang.LinkAnh ?? "/gallery/team.jpg")" class="absolute inset-0 object-cover w-full h-full" />
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
</main>