@model WEB_TinhNguyen.Models.CauHinhKyUc

@{
    ViewData["Title"] = "Nhìn lại mùa " + ViewBag.Nam;
    // Lấy Model an toàn (phòng trường hợp Admin tạo chiến dịch nhưng chưa cấu hình Ký ức)
    var conf = Model ?? new CauHinhKyUc();
}

<style>
    /* Chèn CSS Động (Font, Màu sắc) từ Admin đè lên giao diện */
    .dynamic-font {
        font-family: '@(conf.FontTieuDe ?? "Dancing Script")', cursive !important;
    }

    .dynamic-font-tongket {
        font-family: '@(conf.FontTieuDeTongKet ?? "Be Vietnam Pro")', sans-serif !important;
    }

    .dynamic-bg {
        background: linear-gradient(to bottom, #e0f7fa, @(conf.MauNenHienTai ?? "#c9ecf2"), #fffdd0) !important;
    }

    .dynamic-text {
        color: @(conf.MauChuDao ?? "#7cc34a") !important;
    }

    .dynamic-text-dark {
        color: @(conf.MauChu ?? "#1b5e20") !important;
    }
</style>

<main>
    <!-- HERO SECTION ĐỘNG -->
    <!-- Bỏ class dynamic-bg ở thẻ section này để nền không đè lên ảnh -->
    <section class="relative flex items-center overflow-hidden px-6 text-center min-h-[100svh] py-24 sm:py-32">

        <!-- Lớp 1: Màu nền Gradient dưới cùng (-z-20) -->
        <div class="absolute inset-0 -z-20 dynamic-bg"></div>

        <!-- Lớp 2: Lớp ảnh nền (-z-10) -->
        <div class="absolute inset-0 -z-10 overflow-hidden">
            @if (!string.IsNullOrEmpty(conf.LinkAnhBia))
            {
                <img alt="Hero Banner" src="@conf.LinkAnhBia" class="object-cover h-full w-full opacity-60 transition-all duration-500" />
            }
            else
            {
                <img alt="Hero Banner" src="/gallery/team.jpg" class="object-cover h-full w-full opacity-60 transition-all duration-500" />
            }
            <!-- Lớp 3: Lớp phủ Gradient đè lên ảnh (Trên mờ trong suốt, dưới đặc dần thành màu trắng) -->
            <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/60 to-white dark:via-black/60 dark:to-night-2"></div>
        </div>

        <!-- Nội dung nổi lên trên (z-10) -->
        <div class="relative z-10 mx-auto w-full max-w-3xl">
            <!-- Badge Hồi ức -->
            <span class="mb-3 inline-block rounded-full px-5 py-1.5 text-xs font-bold uppercase tracking-[0.2em] backdrop-blur text-white shadow-sm" style="background-color: @(conf.MauChuDao ?? "#7cc34a");">
                Hồi ức
            </span>

            <!-- Tiêu đề (Đã sửa lỗi CSS, dùng drop-shadow của Tailwind) -->
            <h1 class="font-display pb-3 font-bold leading-[1.18] sm:pb-5 text-4xl sm:text-6xl md:text-7xl dynamic-font drop-shadow-md" style="color: @(conf.MauChuDao ?? "#2e7d32");">
                @conf.TieuDeChinh
            </h1>

            <!-- Mô tả ngắn -->
            <p class="mx-auto mt-5 max-w-xl text-base sm:text-lg font-medium drop-shadow-sm" style="color: @(conf.MauChu ?? "#1b5e20");">
                @conf.DoanVanMoTa
            </p>
        </div>
    </section>
    <!-- TỔNG KẾT HÀNH TRÌNH ĐỘNG -->
    <section class="relative py-24 sm:py-32">
        <div class="mx-auto max-w-6xl px-6">
            <div class="mx-auto mb-16 max-w-3xl text-center">
                <span class="mb-3 inline-block rounded-full bg-leaf/15 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-leaf-deep">Tổng kết hành trình</span>

                <!-- Tiêu đề lấy nội dung, font chữ và màu sắc từ Admin -->
                <h2 class="text-3xl font-extrabold leading-tight sm:text-4xl md:text-5xl dynamic-font-tongket" style="color: @(conf.MauTieuDeTongKet ?? "#1b5e20");">
                    @conf.TieuDeTongKet
                </h2>

            </div>
            <div class="relative mx-auto max-w-4xl">
                <div class="relative rounded-3xl bg-leaf/5 p-6 ring-1 ring-leaf/10 sm:p-10">
                    <div class="tsl-prose text-base leading-relaxed text-forest/85 sm:text-lg">
                        @Html.Raw(conf.NoiDungTongKetHtml ?? "<p>Nội dung đang cập nhật...</p>")
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- GALLERY ẢNH ĐỘNG (Render bằng LightGallery) -->
    <section class="relative py-24 sm:py-32">
        <div class="mx-auto max-w-7xl px-6">
            <div class="mx-auto max-w-2xl text-center mb-14">
                <h2 class="whitespace-pre-line text-3xl font-extrabold leading-tight dynamic-text-dark sm:text-4xl">Khoảnh khắc mùa @ViewBag.Nam</h2>
            </div>

            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5 lg:grid-cols-5" id="lightgallery">
                @if (conf.AnhKyUcs != null && conf.AnhKyUcs.Any())
                {
                    foreach (var img in conf.AnhKyUcs.OrderBy(x => x.ThuTu))
                    {
                        <button type="button" data-src="@img.LinkAnh" class="group relative block cursor-pointer rounded-3xl outline-none @(img.LaAnhDoc ? "row-span-2" : "")">
                            <div class="group relative overflow-hidden rounded-3xl bg-leaf/10 h-full w-full aspect-square">
                                <img alt="@img.TieuDeAnh" src="@img.LinkAnh" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
                                <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/35 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
                            </div>
                            <span class="pointer-events-none absolute inset-x-0 bottom-0 translate-y-2 p-4 text-left text-sm font-semibold text-white opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">
                                @img.TieuDeAnh
                            </span>
                        </button>
                    }
                }
            </div>
        </div>
    </section>

    <!-- NHÀ TÀI TRỢ ĐỘNG -->
    <section class="relative overflow-x-hidden py-16 sm:py-24 dynamic-bg">
        <div class="mx-auto max-w-7xl px-5 sm:px-6">

            <div class="mx-auto max-w-3xl text-center mb-12">
                <span class="mb-4 sm:mb-6 inline-block rounded-full bg-[#f5a623]/15 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-[#f5a623]">Đơn vị đồng hành</span>
                <h2 class="whitespace-pre-line text-3xl font-extrabold leading-tight dynamic-text-dark sm:text-4xl">
                    Cảm ơn những <span class="inline-block text-[#f5a623]">tấm lòng vàng</span>
                </h2>
                <p class="mt-4 text-base text-gray-600 sm:text-lg">Sự đồng hành của các đơn vị dưới đây giúp ánh trăng của chúng mình toả sáng hơn.</p>
            </div>

            @if (conf.NhaTaiTroKyUcs != null && conf.NhaTaiTroKyUcs.Any())
            {
                // Nhóm các nhà tài trợ lại theo Phân loại (VD: "Đơn vị tổ chức", "Tài trợ chính"...)
                var groupedSponsors = conf.NhaTaiTroKyUcs.GroupBy(n => n.PhanLoai);

                <div class="mt-12 space-y-10 sm:mt-14 sm:space-y-12">
                    @foreach (var group in groupedSponsors)
                    {
                        <div class="w-full">
                            <!-- Tiêu đề Phân loại -->
                            <div class="mb-5 flex items-center gap-4">
                                <!-- Bạn có thể dùng dynamic-text hoặc màu cố định cho Tiêu đề phân loại -->
                                <h3 class="text-sm font-bold uppercase tracking-widest dynamic-text-dark">@group.Key</h3>
                                <div class="h-px flex-1 bg-gradient-to-r from-[#2e7d32]/40 to-transparent"></div>
                            </div>

                            <!-- BỌC CÁC LOGO BẰNG FLEX WRAP HOẶC GRID -->
                            <!-- Dùng flex-wrap và justify-center để dàn đều logo ra giữa, tự động rớt dòng khi full ngang -->
                            <div class="flex flex-wrap justify-center gap-5 sm:gap-6">
                                @foreach (var sponsor in group)
                                {
                                    <button type="button" title="@sponsor.TenDonVi" aria-label="Xem giới thiệu @sponsor.TenDonVi" class="group relative flex h-28 w-44 items-center justify-center rounded-2xl bg-white p-5 ring-1 ring-[#4caf50]/10 transition hover:-translate-y-1.5 sm:h-32 sm:w-56 sm:p-6 shadow-sm">

                                        <!-- Hiển thị Logo -->
                                        @if (!string.IsNullOrEmpty(sponsor.LinkLogo))
                                        {
                                            <img alt="@sponsor.TenDonVi" src="@sponsor.LinkLogo" class="object-contain w-full h-full transition duration-300 group-hover:scale-105" />
                                        }
                                        else
                                        {
                                            <!-- Icon mặc định nếu Admin quên up ảnh -->
                                            <svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                        }

                                        <!-- Tên đơn vị hiện lên khi trỏ chuột vào (Hover effect) -->
                                        <span class="pointer-events-none absolute left-1/2 top-full z-10 mt-2 -translate-x-1/2 translate-y-1 whitespace-nowrap rounded-full bg-[#1b5e20] px-3 py-1 text-xs font-semibold text-white opacity-0 transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100 shadow-md">
                                            @sponsor.TenDonVi
                                        </span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center text-gray-500 py-10 italic">
                    Chưa có dữ liệu nhà tài trợ. Admin vui lòng thêm ở trang cấu hình.
                </div>
            }
        </div>
    </section>
</main>