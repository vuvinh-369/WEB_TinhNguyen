            <div class="mt-12 pt-6 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4">
                <p class="text-xs text-white/50 font-medium text-center md:text-left">&copy; @DateTime.Now.Year - Trăng Sáng Langbiang.</p>
            </div>
        </div>
    </footer>

    <!-- THANH LIQUID BOTTOM NAVIGATION MOBILE -->
    <div class="navigation lg:hidden">
        <ul>
            <li class="list" data-url="/home/index">
                <a href="/">
                    <span class="icon"><i class="fas fa-home"></i></span>
                    <span class="text">Trang chủ</span>
                </a>
            </li>
            <li class="list" data-url="/home/chuongtrinh">
                <a href="/Home/ChuongTrinh">
                    <span class="icon"><i class="fas fa-calendar-alt"></i></span>
                    <span class="text">Sự kiện</span>
                </a>
            </li>
            <li class="list" data-url="/home/kyuc">
                <a href="/Home/KyUc?year=@currentYear">
                    <span class="icon"><i class="fas fa-history"></i></span>
                    <span class="text">Ký ức</span>
                </a>
            </li>
            <li class="list" data-url="/home/gayquy">
                <a href="/Home/GayQuy">
                    <span class="icon"><i class="fas fa-heart"></i></span>
                    <span class="text">Đóng góp</span>
                </a>
            </li>
            <li class="list" data-url="/home/bantochuc">
                <a href="/Home/BanToChuc">
                    <span class="icon"><i class="fas fa-users"></i></span>
                    <span class="text">Tổ chức</span>
                </a>
            </li>
            <li class="list" data-url="/home/tintuc">
                <a href="/Home/TinTuc">
                    <span class="icon"><i class="fas fa-newspaper"></i></span>
                    <span class="text">Tin tức</span>
                </a>
            </li>
            <div class="indicator"></div>
        </ul>
    </div>

    <!-- CODE GỌI HIỆU ỨNG TỪ DATABASE -->
    @{
        int? currentEffectId = activeConfig?.IDHieuUng;
        if (currentEffectId != null)
        {
            var effect = _context.ThuVienHieuUngs.Find(currentEffectId);
            if (effect != null && !string.IsNullOrEmpty(effect.LinkFileJS) && effect.TrangThai == true)
            {
                <script src="@effect.LinkFileJS"></script>
            }
        }
    }

    <!-- JAVASCRIPT ĐIỀU KHIỂN -->
    <script>
            document.addEventListener('DOMContentLoaded', function() {
                /* 1. XỬ LÝ THANH LIQUID BOTTOM NAV TRÊN MOBILE */
                const listItems = document.querySelectorAll('.navigation .list');
                const indicator = document.querySelector('.navigation .indicator');

                function setActiveBottomNav() {
                    let currentPath = window.location.pathname.toLowerCase();
                    if (currentPath === '/' || currentPath === '') currentPath = '/home/index';

                    let itemWidth = 100 / listItems.length;

                    listItems.forEach((item, index) => {
                        item.classList.remove('active');
                        let itemPath = item.getAttribute('data-url');

                        // So sánh đường dẫn
                        if (currentPath.includes(itemPath) || (itemPath === '/home/index' && currentPath === '/')) {
                            item.classList.add('active');
                            let centerPosition = (index * itemWidth) + (itemWidth / 2);
                            indicator.style.left = `calc(${centerPosition}%)`;
                        }
                    });
                }
                setActiveBottomNav();

                /* 2. XỬ LÝ LÒ XO SỢI DÂY KÉO (PULL CORD PHYSICS) */
                const wrapper = document.getElementById('pullcord-wrapper');
                const hitarea = document.getElementById('pullcord-hitarea');
                const line = document.getElementById('pullcord-line');
                const handle = document.getElementById('pullcord-handle');

                let startY = 0;
                let currentY = 0;
                let isDragging = false;
                const stretchMax = 100;
                const triggerDistance = 45;

                function onDragStart(e) {
                    if (e.type === 'mousedown' && e.button !== 0) return;
                    isDragging = true;
                    startY = e.type === 'touchstart' ? e.touches[0].clientY : e.clientY;
                    wrapper.classList.remove('cord-snap');
                    line.style.transition = 'none';
                    handle.style.transition = 'none';
                    hitarea.style.cursor = 'grabbing';
                    document.addEventListener('mousemove', onDragMove, { passive: false });
                    document.addEventListener('touchmove', onDragMove, { passive: false });
                    document.addEventListener('mouseup', onDragEnd);
                    document.addEventListener('touchend', onDragEnd);
                }

                function onDragMove(e) {
                    if (!isDragging) return;
                    e.preventDefault();
                    let clientY = e.type === 'touchmove' ? e.touches[0].clientY : e.clientY;
                    currentY = clientY - startY;
                    if (currentY < 0) currentY = 0;
                    let displayY = currentY;
                    if (currentY > stretchMax) { displayY = stretchMax + (currentY - stretchMax) * 0.15; }
                    line.style.transform = `scaleY(${(120 + displayY) / 120})`;
                    handle.style.transform = `translateY(${displayY}px)`;
                }

                function onDragEnd() {
                    if (!isDragging) return;
                    isDragging = false;
                    document.removeEventListener('mousemove', onDragMove);
                    document.removeEventListener('touchmove', onDragMove);
                    document.removeEventListener('mouseup', onDragEnd);
                    document.removeEventListener('touchend', onDragEnd);
                    hitarea.style.cursor = 'grab';
                    wrapper.classList.add('cord-snap');
                    line.style.transition = '';
                    handle.style.transition = '';

                    if (currentY > triggerDistance) { toggleTheme(); }

                    currentY = 0;
                    line.style.transform = `scaleY(1)`;
                    handle.style.transform = `translateY(0px)`;
                }

                /* 3. ĐỔI MÀU GIAO DIỆN (THEME SYNC) */
                function toggleTheme() {
                    const isNowDark = !document.documentElement.classList.contains('dark');
                    if (isNowDark) {
                        document.documentElement.classList.add('dark');
                        localStorage.setItem('theme', 'dark');
                    } else {
                        document.documentElement.classList.remove('dark');
                        localStorage.setItem('theme', 'light');
                    }
                    syncInlineColorsForTheme(isNowDark);
                }

                function syncInlineColorsForTheme(isDark) {
                    const elements = document.querySelectorAll('main [style*="color"]');
                    elements.forEach(el => {
                        if (el.closest('.keep-theme') || el.style.backgroundColor || el.style.background || el.classList.contains('keep-color')) { return; }
                        if (!el.dataset.origColor && el.style.color) { el.dataset.origColor = el.style.color; }
                        if (isDark) {
                            const tag = el.tagName.toLowerCase();
                            if (tag === 'h1' || tag === 'h2' || tag === 'h3' || tag === 'h4') el.style.setProperty('color', '#86efac', 'important');
                            else el.style.setProperty('color', '#f1f5f9', 'important');
                        } else {
                            if (el.dataset.origColor) el.style.color = el.dataset.origColor;
                            else el.style.removeProperty('color');
                        }
                    });
                }

                hitarea.addEventListener('mousedown', onDragStart);
                hitarea.addEventListener('touchstart', onDragStart, { passive: false });

                try {
                    const isInitialDark = document.documentElement.classList.contains('dark');
                    syncInlineColorsForTheme(isInitialDark);
                } catch (e) { }
            });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>