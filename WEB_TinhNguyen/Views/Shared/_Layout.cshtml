@using Microsoft.EntityFrameworkCore
@using WEB_TinhNguyen.Data
@inject ApplicationDbContext _context
@{
    var activeConfig = _context.CauHinhTrangChus
        .Include(c => c.ChienDich)
        .Where(c => c.ChienDich.TrangThaiHoatDong == true)
        .FirstOrDefault();

    string? logoImg = activeConfig?.LinkAnhBia;
    string? textTop = activeConfig?.TieuDePhu;
    string? textBot = activeConfig?.TieuDeChinh;

    string bgWeb = activeConfig?.MauNenStart ?? "#ffffff";
    string colorMain = activeConfig?.MauChuDao ?? "#2e7d32";
    string colorSub = activeConfig?.MauNhan ?? "#4caf50";
    string colorText = activeConfig?.MauChu ?? "#1b5e20";

    string fontTitle = activeConfig?.FontTieuDe != null ? activeConfig.FontTieuDe.Replace(" ", "+") : "Be+Vietnam+Pro";
    string fontBody = activeConfig?.FontNoiDung != null ? activeConfig.FontNoiDung.Replace(" ", "+") : "Be+Vietnam+Pro";

    // Lấy năm hiện tại để gán link cho nút Ký ức
    int currentYear = activeConfig?.ChienDich?.Nam ?? DateTime.Now.Year;
}

<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0">
    <meta name="theme-color" content="@colorMain" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0c1712" media="(prefers-color-scheme: dark)">
    <title>@ViewData["Title"] @(!string.IsNullOrEmpty(textBot) ? "- " + textBot : "")</title>

    @if (!string.IsNullOrEmpty(logoImg))
    {
        <link rel="shortcut icon" href="@logoImg">
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- FONT CHỮ VÀ ICON FONT AWESOME -->
    <link href="https://fonts.googleapis.com/css2?family=@(fontTitle):wght@400;700;900&family=@(fontBody):wght@300;400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
            tailwind.config = {
                darkMode: 'class',
                theme: { extend: { colors: { 'night': '#0c1712', 'night-2': '#14241b' } } }
            }
    </script>

    <!-- SCRIPT ƯU TIÊN CHẠY ĐẦU TIÊN ĐỂ FIX LỖI NHÁY GIAO DIỆN -->
    <script>
            (function() {
                try {
                    var theme = localStorage.getItem('theme');
                    // Nếu người dùng đã từng kéo dây bật TỐI thì giữ TỐI
                    if (theme === 'dark') {
                        document.documentElement.classList.add('dark');
                    } else {
                        // MẶC ĐỊNH LUÔN LÀ SÁNG ĐẦU TIÊN VÀ XÓA CLASS DARK
                        document.documentElement.classList.remove('dark');
                        localStorage.setItem('theme', 'light');
                    }
                } catch (e) { console.error('Lỗi đọc theme:', e); }
            })();
    </script>

    <style>
            :root {
                --bg-web: @bgWeb;
                --color-main: @colorMain;
                --color-sub: @colorSub;
                --color-text: @colorText;
                --font-title: '@(activeConfig?.FontTieuDe ?? "Be Vietnam Pro")', sans-serif;
                --font-body: '@(activeConfig?.FontNoiDung ?? "Be Vietnam Pro")', sans-serif;
                --crater-color: @bgWeb;
            }

            body {
                font-family: var(--font-body);
            }

            /* MÀU SÁNG & TỐI CƠ BẢN */
            html:not(.dark) body {
                background-color: var(--bg-web) !important;
                color: var(--color-text);
            }

            html:not(.dark) .logo-font-main {
                font-family: var(--font-title);
                color: var(--color-main) !important;
            }

            html:not(.dark) .logo-font-sub {
                color: var(--color-sub) !important;
            }

            html.dark body {
                background-color: #0c1712 !important;
                color: #f1f5f9 !important;
            }

            html.dark .logo-font-main {
                font-family: var(--font-title);
                color: #86efac !important;
            }

            html.dark .logo-font-sub {
                color: #bbf7d0 !important;
            }

            html.dark {
                --crater-color: #0c1712;
            }

                /* BẢO VỆ MÀU CHỮ CHẾ ĐỘ TỐI */
                html.dark main p:not(.keep-color):not(.keep-theme *), html.dark main li:not(.keep-color):not(.keep-theme *), html.dark main span:not([class*="bg-"]):not(.keep-color):not(.keep-theme *), html.dark main div:not([class*="bg-white"]):not(.keep-color):not(.keep-theme *), html.dark main .prose *:not(.keep-color):not(.keep-theme *) {
                    color: #e2e8f0 !important;
                }

                html.dark main h1:not(.keep-color):not(.keep-theme *), html.dark main h2:not(.keep-color):not(.keep-theme *), html.dark main h3:not(.keep-color):not(.keep-theme *), html.dark main h4:not(.keep-color):not(.keep-theme *) {
                    color: #ffffff !important;
                }

                html.dark main [class*="rounded-full"][style*="background"], html.dark main a[style*="background"], html.dark main button[style*="background"], html.dark main .text-white {
                    color: #ffffff !important;
                }

                html.dark main section[style*="background"], html.dark main[style*="background"] {
                    background: linear-gradient(to bottom, #0a1626, #0c1712, #122118) !important;
                }

                html.dark main .bg-white, html.dark main .bg-white\/85, html.dark main .bg-white\/80, html.dark main .bg-white\/70 {
                    background-color: #16261d !important;
                    border-color: rgba(134, 239, 172, 0.2) !important;
                }

                html.dark #newsReaderModal > div, html.dark #qrModal > div, html.dark #sponsorModal > div {
                    background-color: #16261d !important;
                    border-color: rgba(255, 255, 255, 0.12) !important;
                    color: #f1f5f9 !important;
                }

                html.dark #newsReaderModal .sticky {
                    background-color: #16261d !important;
                    border-color: rgba(255, 255, 255, 0.1) !important;
                }

                html.dark #newsReaderModal #modalPostBody, html.dark #newsReaderModal #modalPostBody * {
                    color: #e2e8f0 !important;
                }

            /* =====================================================================
                           CSS DÂY KÉO BẬT ĐÈN VẬT LÝ
                           ===================================================================== */
            #pullcord-wrapper, #pullcord-hitarea, #pullcord-line, #pullcord-handle {
                user-select: none;
                -webkit-user-select: none;
                -webkit-user-drag: none;
            }

            #pullcord-wrapper {
                position: fixed;
                top: 0;
                right: 1rem;
                z-index: 99999;
                display: flex;
                flex-direction: column;
                align-items: center;
            }
            @@media (min-width: 768px) {
                #pullcord-wrapper {
                    right: 7rem;
                }
            }

            #pullcord-hitarea {
                position: absolute;
                top: 0;
                left: -15px;
                width: 34px;
                height: 160px;
                cursor: grab;
                z-index: 10;
                touch-action: none;
            }

                #pullcord-hitarea:active {
                    cursor: grabbing;
                }

            #pullcord-line {
                width: 2px;
                height: 120px;
                background-color: rgba(0, 0, 0, 0.4);
                transform-origin: top center;
            }

            html.dark #pullcord-line {
                background-color: rgba(255, 255, 255, 0.5);
            }

            #pullcord-handle {
                width: 24px;
                height: 24px;
                border-radius: 50%;
                background-color: #2e7d32;
                border: 2px solid #ffffff;
                box-shadow: 0 4px 10px rgba(0,0,0,0.3);
                margin-top: -1px;
            }

            html.dark #pullcord-handle {
                background-color: #f1f5f9;
                border-color: #0c1712;
            }

            .cord-snap #pullcord-line, .cord-snap #pullcord-handle {
                transition: transform 0.5s cubic-bezier(0.4, 2.5, 0.4, 1);
            }

            /* =====================================================================
                           CSS BOTTOM NAVIGATION MƯỢT MÀ
                           ===================================================================== */
            .navigation {
                position: fixed;
                bottom: 15px;
                left: 50%;
                transform: translateX(-50%);
                width: 96%;
                height: 70px;
                background: #222327;
                border-radius: 20px;
                display: flex;
                justify-content: center;
                align-items: center;
                z-index: 9999;
                box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            }

            html.dark .navigation {
                background: #1a1b1f;
                border: 1px solid rgba(255,255,255,0.05);
            }

            .navigation ul {
                display: flex;
                width: 100%;
                height: 100%;
                margin: 0;
                padding: 0;
                position: relative;
            }

                .navigation ul li {
                    position: relative;
                    list-style: none;
                    flex: 1;
                    height: 100%;
                    z-index: 2;
                }

                    .navigation ul li a {
                        position: relative;
                        display: block;
                        width: 100%;
                        height: 100%;
                        text-align: center;
                        -webkit-tap-highlight-color: transparent;
                    }

                        .navigation ul li a .icon {
                            position: absolute;
                            top: 50%;
                            left: 50%;
                            transform: translate(-50%, -50%);
                            font-size: 1.4rem;
                            color: rgba(255, 255, 255, 0.5);
                            transition: 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
                            z-index: 10;
                        }

                    .navigation ul li.active a .icon {
                        top: 0px;
                        color: #222327;
                        font-size: 1.5rem;
                    }

            html.dark .navigation ul li.active a .icon {
                color: #1a1b1f;
            }

            .navigation ul li a .text {
                position: absolute;
                bottom: -20px;
                left: 50%;
                transform: translateX(-50%);
                color: #ffffff;
                font-weight: 600;
                font-size: 10px;
                letter-spacing: 0.05em;
                transition: 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
                opacity: 0;
                pointer-events: none;
                white-space: nowrap;
            }

            .navigation ul li.active a .text {
                opacity: 1;
                bottom: 12px;
            }

            .navigation .indicator {
                position: absolute;
                top: -36px;
                width: 60px;
                height: 60px;
                background: #ffffff;
                border-radius: 50%;
                border: 6px solid #222327;
                transition: 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
                transform: translateX(-50%);
                box-sizing: content-box;
                z-index: 1;
            }

            html.dark .navigation .indicator {
                background: #86efac;
                border-color: #1a1b1f;
            }

            @@media (max-width: 1023px) {
                body {
                    padding-bottom: 100px;
                }
            }
    </style>
</head>

<body class="text-gray-800 dark:bg-night dark:text-gray-100 transition-colors duration-300 relative">

    <div id="pullcord-wrapper" title="Kéo xuống để tắt/bật đèn">
        <div id="pullcord-hitarea"></div>
        <div id="pullcord-line"></div>
        <div id="pullcord-handle"></div>
    </div>

    <!-- Header -->
    <header id="main-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300 bg-white/90 dark:bg-night/90 backdrop-blur-md shadow-sm py-2 border-b border-transparent dark:border-white/10">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-5">
            <a href="/" class="flex min-w-0 items-center gap-2 sm:gap-2.5">
                @if (!string.IsNullOrEmpty(logoImg))
                {
                    <span class="relative flex h-11 w-11 items-center justify-center overflow-hidden">
                        <img alt="Logo" width="44" height="44" class="object-contain" src="@logoImg">
                    </span>
                }
                <span class="min-w-0 leading-tight">
                    @if (!string.IsNullOrEmpty(textTop))
                    {
                        <span class="block text-[10px] font-bold uppercase tracking-wider logo-font-sub sm:text-[11px]">@textTop</span>
                    }
                    @if (!string.IsNullOrEmpty(textBot))
                    {
                        <span class="block truncate text-lg font-black logo-font-main sm:text-2xl pt-0.5">@Html.Raw(textBot.Replace("\n", "<br/>"))</span>
                    }
                </span>
            </a>

            <!-- Menu Desktop -->
            <nav class="hidden items-center gap-1 lg:flex pr-24">
                <a class="rounded-full px-3.5 py-2 text-sm font-medium text-gray-700 transition hover:bg-leaf/10 hover:text-leaf-deep dark:text-gray-100 dark:hover:bg-white/10 dark:hover:text-leaf-bright" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a class="rounded-full px-3.5 py-2 text-sm font-medium text-gray-700 transition hover:bg-leaf/10 hover:text-leaf-deep dark:text-gray-100 dark:hover:bg-white/10 dark:hover:text-leaf-bright" asp-area="" asp-controller="Home" asp-action="ChuongTrinh">Chương trình</a>
                <a class="rounded-full px-3.5 py-2 text-sm font-medium text-gray-700 transition hover:bg-leaf/10 hover:text-leaf-deep dark:text-gray-100 dark:hover:bg-white/10 dark:hover:text-leaf-bright" asp-area="" asp-controller="Home" asp-action="GayQuy">Đóng góp</a>
                <a class="rounded-full px-3.5 py-2 text-sm font-medium text-gray-700 transition hover:bg-leaf/10 hover:text-leaf-deep dark:text-gray-100 dark:hover:bg-white/10 dark:hover:text-leaf-bright" asp-area="" asp-controller="Home" asp-action="BanToChuc">Ban tổ chức</a>
                <a class="rounded-full px-3.5 py-2 text-sm font-medium text-gray-700 transition hover:bg-leaf/10 hover:text-leaf-deep dark:text-gray-100 dark:hover:bg-white/10 dark:hover:text-leaf-bright" asp-area="" asp-controller="Home" asp-action="TinTuc">Tin tức</a>

                <div class="relative group">
                    <button type="button" class="flex items-center gap-1.5 rounded-full px-3.5 py-2 text-sm font-medium text-gray-700 dark:text-gray-100 transition hover:bg-leaf/15 hover:text-leaf-deep dark:hover:bg-white/10 dark:hover:text-leaf-bright">
                        Ký ức <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
                    </button>
                    <div class="absolute right-0 top-full mt-1 w-36 rounded-xl bg-white dark:bg-night-2 p-1.5 shadow-lg ring-1 ring-black/5 dark:ring-white/10 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 z-50">
                        @{
                            var cacNam = _context.ChienDichs.Select(c => c.Nam).Distinct().OrderBy(n => n).ToList();
                            foreach (var nam in cacNam)
                            {
                                <a href="@Url.Action("KyUc", "Home", new { year = nam })" class="block rounded-lg px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 transition hover:bg-leaf/15 hover:text-leaf-deep dark:hover:bg-white/10 dark:hover:text-leaf-bright">Mùa @nam</a>
                            }
                        }
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main class="min-h-screen pt-[60px] md:pt-[72px]">
        @RenderBody()
    </main>

    <!-- FOOTER MÀU XANH -->
    <footer class="relative mt-24 bg-[#143220] dark:bg-[#0b1b11] text-white transition-colors duration-300">
        <div class="absolute top-0 left-0 w-full overflow-hidden leading-none transform -translate-y-full">
            <svg viewBox="0 0 1440 100" preserveAspectRatio="none" class="block w-full h-[60px] md:h-[90px]">
                <path d="M0,32L60,42.7C120,53,240,75,360,74.7C480,75,600,53,720,48C840,43,960,53,1080,58.7C1200,64,1320,64,1380,64L1440,64L1440,100L1380,100C1320,100,1200,100,1080,100C960,100,840,100,720,100C600,100,480,100,360,100C240,100,120,100,60,100L0,100Z" class="fill-[#1e4b30] dark:fill-[#122b1c] transition-colors duration-300"></path>
                <path d="M0,64L60,58.7C120,53,240,43,360,48C480,53,600,75,720,80C840,85,960,75,1080,64C1200,53,1320,43,1380,37.3L1440,32L1440,100L1380,100C1320,100,1200,100,1080,100C960,100,840,100,720,100C600,100,480,100,360,100C240,100,120,100,60,100L0,100Z" class="fill-[#143220] dark:fill-[#0b1b11] transition-colors duration-300"></path>
            </svg>
        </div>

        @if (activeConfig != null && activeConfig.HienThiMascot == true && !string.IsNullOrEmpty(activeConfig.LinkAnhMascot))
        {
            string posClass = "right-6 sm:right-20";
            if (activeConfig.ViTriMascot == "left") posClass = "left-6 sm:left-20";
            if (activeConfig.ViTriMascot == "center") posClass = "left-1/2 -translate-x-1/2";
            <div class="pointer-events-none select-none absolute -top-[100px] sm:-top-[130px] @posClass z-10 transition-transform duration-300 hover:scale-105 animate-float" title="Linh vật dự án">
                <img alt="Linh vật" loading="lazy" class="h-auto w-28 sm:w-36 object-contain drop-shadow-[0_15px_15px_rgba(0,0,0,0.3)]" src="@activeConfig.LinkAnhMascot">
            </div>
        }

        <div class="mx-auto max-w-7xl px-6 pb-8 pt-10 md:pt-14 relative z-10">
            <div class="grid gap-12 md:grid-cols-12">
                <div class="md:col-span-5 lg:col-span-4">
                    <a href="/" class="inline-flex items-center gap-3 mb-6 bg-white/5 hover:bg-white/10 py-2.5 px-3.5 rounded-2xl border border-white/10 backdrop-blur-sm transition shadow-sm">
                        @if (!string.IsNullOrEmpty(logoImg))
                        {
                            <div class="bg-white p-1.5 rounded-xl shadow-inner shrink-0">
                                <img alt="Logo Footer" loading="lazy" class="h-10 w-10 sm:h-11 sm:w-11 object-contain" src="@logoImg">
                            </div>
                        }
                        <div class="leading-tight">
                            @if (!string.IsNullOrEmpty(textTop))
                            {
                                <span class="block text-[10px] font-extrabold uppercase tracking-widest text-emerald-400 mb-0.5">@textTop</span>
                            }
                            @if (!string.IsNullOrEmpty(textBot))
                            {
                                <span class="block font-black text-white text-lg sm:text-xl leading-none" style="font-family: var(--font-title);">@Html.Raw(textBot.Replace("\n", " "))</span>
                            }
                        </div>
                    </a>
                    <p class="text-white/70 text-sm leading-relaxed mb-6 font-medium pr-4">
                        Dự án tình nguyện mang mùa xuân ấm áp đến các em nhỏ. Hành trình kết nối những trái tim yêu thương.
                    </p>
                    <div class="flex items-center gap-3">
